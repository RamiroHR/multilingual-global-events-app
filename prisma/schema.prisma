generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  Int                @id @default(autoincrement())
  email               String             @unique
  username            String             @unique
  createdEvents       Event[]            @relation("EventCreator")
  participatingEvents EventParticipant[] @relation("Participant")
  password            Password?          @relation("UserToPassword")
}

model Password {
  id        Int      @id @default(autoincrement())
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    Int      @unique
  user      User     @relation("UserToPassword", fields: [userId], references: [id], onDelete: Cascade)
}

model Event {
  id           Int                @id @default(autoincrement())
  title        String             @default("Title")
  description  String             @default("Description")
  date         DateTime
  location     String?
  isOnline     Boolean            @default(false)
  maxCapacity  Int                @default(2)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  creatorId    Int
  isCancelled  Boolean            @default(false)
  webinar      String?            @default("")
  creator      User               @relation("EventCreator", fields: [creatorId], references: [id])
  participants EventParticipant[] @relation("EventParticipants")
}

model EventParticipant {
  id        Int      @id @default(autoincrement())
  status    String   @default("PENDING")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  eventId   Int
  userId    Int
  event     Event    @relation("EventParticipants", fields: [eventId], references: [id])
  user      User     @relation("Participant", fields: [userId], references: [id])

  @@unique([eventId, userId])
}
